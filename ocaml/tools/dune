; Regenerates vectors/vectors.json from vectors/inputs.json using the verified
; core. This is what makes F* the source of truth for the vectors rather than
; the Python reference.
(executable
 (name gen_vectors)
 (modules gen_vectors)
 (libraries tessarium tessarium_extracted zarith yojson))

; Emits ocaml/lib/wordlist.ml. Kept as a build step rather than a committed
; file so the module cannot drift from wordlist/english.txt.
; Emits fstar/check/Tessarium.Check.Expected.fst: the extracted core's
; answers on fixed points, for F*'s own evaluator to recompute. The bridge
; between the proved source and the binary; see the file's header.
(executable
 (name gen_check)
 (modules gen_check)
 (libraries tessarium tessarium_extracted fstarlib zarith str))

(executable
 (name gen_wordlist)
 (modules gen_wordlist))

; Emits a large corpus for js/differential.mjs to check, weighted towards band
; seams. The extraction pipeline is trusted rather than verified, so an
; independent implementation disagreeing is the only signal available.
(executable
 (name differential)
 (modules differential)
 (libraries tessarium tessarium_extracted zarith unix))

; Embeds the built UI into the server binary. See gen_assets.ml for why the
; assets are stored gzipped rather than raw.
(executable
 (name gen_assets)
 (modules gen_assets)
 (libraries gzip))

; The basemap fixture the end-to-end test downloads from: a tiny valid
; PMTiles archive plus the sprite/glyph tarball. Lets the e2e exercise the
; whole in-app downloader against this project's own server, offline.
(executable
 (name gen_basemap_fixture)
 (modules gen_basemap_fixture)
 (libraries pmtiles gzip))
(executable
 (name bench_encode)
 (modules bench_encode)
 (libraries tessarium unix zarith))
