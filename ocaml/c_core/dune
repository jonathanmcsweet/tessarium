; The KaRaMeL-emitted verified core (vendor/, committed generated code --
; regenerate with `make sync-c-core`, CI diffs it) behind an OCaml FFI.
; A separate library, NOT part of `tessarium`: that library also
; compiles under js_of_ocaml for the browser bundle, and C stubs do not.
(library
 (name tessarium_c_core)
 (libraries tessarium tessarium_extracted zarith)
 (foreign_stubs
  (language c)
  (names c_core_stubs Tessarium_Low_Feistel Tessarium_Low_Grid
    Tessarium_Low_Codec Tessarium_Low_Api Tessarium_Low_Blake2s
    Tessarium_Low_Core)
  (flags (:standard -std=c11 -O2 -Wall -Wno-parentheses -D_DEFAULT_SOURCE))
  (include_dirs vendor)))

(copy_files vendor/*.c)
