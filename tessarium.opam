# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Seed-derived geocoding: three BIP-39 words address every 3 m square"
description: """
A formally verified core, written in F* and extracted to OCaml, mapping every
~3 m square on Earth to three BIP-39 words plus a four-digit number under a
permutation private to the user's seed phrase. The same extraction builds the
native server and, through js_of_ocaml, the browser client."""
license: "Apache-2.0"
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "5.2.0"}
  "zarith"
  "zarith_stubs_js"
  "digestif" {>= "1.3.0"}
  "yojson"
  "js_of_ocaml"
  "js_of_ocaml-ppx"
  "uunf"
  "stdint"
  "ppx_deriving"
  "ppx_deriving_yojson"
  "cohttp-eio"
  "eio_main"
  "eio"
  "tls-eio"
  "mirage-crypto-rng"
  "ca-certs-nss"
  "domain-name"
  "uri"
  "cmdliner"
  "logs"
  "fmt"
  "base64"
  "decompress"
  "bigstringaf"
  "http" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "https://github.com/tessarium/tessarium"
