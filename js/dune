; An independently written implementation of the algorithm, kept as a
; cross-check rather than as architecture: it is the only thing in the tree
; that could catch a bug in the F* extraction by disagreeing with it. Run under
; `dune test` so that any drift shows up immediately instead of at the next
; time someone remembers to run it by hand.
;
; See the roadmap's locked decisions. Do not add features here.
(rule
 (alias runtest)
 (deps tessarium.mjs %{project_root}/wordlist/english.txt bands.json
  %{project_root}/vectors/vectors.json
  ; the oracle's manifest and lockfile: a version bump must re-run this
  %{project_root}/package.json %{project_root}/pnpm-lock.yaml)
 (action (run node %{dep:test_vectors.mjs})))

; The differential sweep. Sized for CI rather than for thoroughness: the
; corpus is dominated by band seams, of which there are 4096, so even a small
; --count covers every one of them. Run it with a larger count by hand when
; changing anything in the grid.
(rule
 (alias runtest)
 (deps
  tessarium.mjs
  %{project_root}/wordlist/english.txt
  bands.json
  %{project_root}/package.json %{project_root}/pnpm-lock.yaml
  (glob_files %{project_root}/ocaml/tools/*.ml))
 ; Piped rather than written to a file: an action with a target is cached as a
 ; build artifact and will not re-run under `dune test --force`, which makes a
 ; test that quietly stops running.
 (action
  (pipe-stdout
   (run %{exe:../ocaml/tools/differential.exe} --count 20000)
   (run node %{dep:differential.mjs} -))))

; The wasm core replaying the same corpus: the browser's half of the
; side-by-side story (the server's half is ocaml/test/test_c_core.ml).
; wasm/core.wasm is committed; `make sync-wasm` rebuilds it with the
; pinned zig, CI diffs it.
(rule
 (alias runtest)
 (deps
  wasm-differential.mjs
  %{project_root}/wasm/core.wasm
  %{project_root}/wordlist/english.txt
  bands.json
  (glob_files %{project_root}/ocaml/tools/*.ml))
 (action
  (pipe-stdout
   (run %{exe:../ocaml/tools/differential.exe} --count 20000)
   (run node %{dep:wasm-differential.mjs} - %{project_root}/wasm/core.wasm
    bands.json %{project_root}/wordlist/english.txt))))

; The Argon2id wasm module (the browser's KDF since kdf-3) against noble's
; independent implementation. wasm/argon2.wasm is committed; `make
; sync-argon2-wasm` rebuilds it with the pinned zig, CI diffs it.
(rule
 (alias runtest)
 (deps argon2-differential.mjs %{project_root}/wasm/argon2.wasm
  %{project_root}/package.json %{project_root}/pnpm-lock.yaml)
 (action (run node %{dep:argon2-differential.mjs} %{project_root}/wasm/argon2.wasm)))

; The real browser worker, driven in node against the extracted core. Unlike
; every other rule here this one's subject is not a library but the shipped
; artifact: ui/public/core.worker.js, loaded unmodified into a sandbox that
; owns its globals. That is what makes "the browser answers from the wasm
; core" observable -- the sandbox owns fetch, so a worker that quietly went
; back to js_of_ocaml never asks for core.wasm and this rule fails.
;
; It depends on both committed wasm modules because it runs the whole chain:
; unlock derives with argon2.wasm and the addresses come out of core.wasm.
(rule
 (alias runtest)
 (deps
  worker-differential.mjs
  %{project_root}/ui/public/core.worker.js
  %{project_root}/ocaml/js/tessarium_js.bc.js
  %{project_root}/wasm/core.wasm
  %{project_root}/wasm/argon2.wasm
  %{project_root}/vectors/vectors.json)
 (action
  (run node %{dep:worker-differential.mjs}
   %{project_root}/ui/public/core.worker.js
   %{project_root}/ocaml/js/tessarium_js.bc.js
   %{project_root}/wasm/core.wasm
   %{project_root}/wasm/argon2.wasm
   %{project_root}/vectors/vectors.json)))
